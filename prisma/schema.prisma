model PayrollPublicHoliday {
  id               String             @id @default(cuid())
  holidayDate      DateTime
  name             String
  // Which teams observe this holiday. Empty means every team, so holidays
  // created before tagging existed keep applying company-wide.
  teamTags         TeamTag[]
  // When this holiday was actually announced by email. Null means never announced,
  // which is what lets an ad-hoc send target only newly added holidays instead of
  // re-mailing a month that has already gone out. The monthly digest on the 1st
  // ignores this and always sends the whole month -- it is a planning view.
  notifiedAt       DateTime?
  financialYearId  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  financialYear    PayrollFinancialYear? @relation(fields: [financialYearId], references: [id], onDelete: SetNull)

  // Was unique on the date alone, which made it impossible to record a Pakistani
  // and a Moroccan holiday that fall on the same day.
  @@unique([holidayDate, name])
  @@index([holidayDate])
  @@index([financialYearId])
}

