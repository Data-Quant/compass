  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users        User[]
  benefits     Benefit[]

  @@index([isActive])
}

model Benefit {
  id          String          @id @default(cuid())
  categoryId  String
  title       String
  description String
  orderIndex  Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  category    BenefitCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, orderIndex])
  @@index([isActive])
}

// ─── Project Management ──────────────────────────────────────────────────────

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectNotificationDigestFrequency {
  HOURLY
  DAILY
  WEEKLY
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  color       String?       // Hex color for visual distinction on cards
  status      ProjectStatus @default(ACTIVE)
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner       User           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  tasks       Task[]
  sections    TaskSection[]
  labels      TaskLabel[]
  references  ProjectReference[]

  @@index([ownerId])
  @@index([status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER") // OWNER or MEMBER
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  sectionId   String?
  parentTaskId String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  completedLate Boolean     @default(false)
  orderIndex  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section     TaskSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parentTask  Task?        @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: Cascade)
  childTasks  Task[]       @relation("TaskChildren")
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assistants  TaskAssistant[]
  comments    TaskComment[]
  activities   TaskActivity[]
  labelAssignments TaskLabelAssignment[]

  @@index([projectId])
  @@index([sectionId])
  @@index([parentTaskId])
  @@index([assigneeId])
  @@index([assigneeId, dueDate])
  @@index([status])
}

model TaskAssistant {
  id           String   @id @default(cuid())
  taskId       String
  userId       String
  assignedById String?
  createdAt    DateTime @default(now())

  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User     @relation("TaskAssistantUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("TaskAssistantAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@index([assignedById])
}

model TaskSection {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  color      String   @default("#6366f1")
  canonicalStatus TaskStatus @default(IN_PROGRESS)
  isDefault  Boolean  @default(false)
  isDone     Boolean  @default(false)
  isBacklog  Boolean  @default(false)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks      Task[]

  @@index([projectId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String?
  summary   String
  kind      String
  metadata  Json?
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User?    @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([actorId])
  @@index([createdAt])
}

model ProjectNotificationPreference {
  id              String                             @id @default(cuid())
  userId          String                             @unique
  digestEnabled   Boolean                            @default(false)
  digestFrequency ProjectNotificationDigestFrequency @default(DAILY)
  digestTime      String                             @default("09:00")
  digestWeekday   Int                                @default(1)
  digestTimezone  String                             @default("Asia/Karachi")
  lastDigestSentAt DateTime?
  nextDigestAt    DateTime?
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt

  user            User                               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([digestEnabled, nextDigestAt])
}

model ProjectTaskViewPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  assigneeFilter String   @default("ME")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assigneeFilter])
}

model ProjectNotificationDigestItem {
  id          String    @id @default(cuid())
  recipientId String
  projectId   String?
  taskId      String?
  type        String
  subject     String
  heading     String
  bodyHtml    String
  actionUrl   String?
  actionLabel String?
  dedupeKey   String?   @unique
  sentAt      DateTime?
  skippedAt   DateTime?
  createdAt   DateTime  @default(now())

  recipient   User      @relation("ProjectNotificationDigestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, sentAt, skippedAt, createdAt])
  @@index([sentAt, skippedAt, createdAt])
  @@index([projectId])
  @@index([taskId])
}

model TaskLabel {
  id        String   @id @default(cuid())
  projectId String
  name      String
  color     String   @default("#6366f1") // Default to primary color

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments TaskLabelAssignment[]

  @@unique([projectId, name])
  @@index([projectId])
}

model ProjectReference {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  url         String?
  note        String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("ProjectReferenceCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdById])
  @@index([updatedAt])
}

model TaskLabelAssignment {
  id      String @id @default(cuid())
  taskId  String
  labelId String

  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   TaskLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
  @@index([taskId])
  @@index([labelId])
}

// ─── Company Handbook ────────────────────────────────────────────────────────
// A page is the concept (Leave Policy); a variant is the content addressed to a
// set of teams. The source document holds four distinct Leave Policies and five
// Core Hours Policies -- same title, different teams, different terms -- so a
// page cannot be a single row carrying a list of tags.

model HandbookPage {
  id                  String            @id @default(cuid())
  slug                String            @unique
  title               String
  icon                String
  category            HandbookCategory
  orderIndex          Int               @default(0)
  linkHref            String?
  linkLabel           String?
  isPublished         Boolean           @default(false)
  /// One line, shown under the title on the hub and searched over. Page-level,
  /// not variant-level: Leave Policy has four variants but one purpose.
  description         String?
  /// null and POLICY both render the policy treatment. Only LETTER differs.
  layout              HandbookLayout?
  /// Teams for which having no variant is a reviewed, deliberate decision.
  intentionalGapTeams TeamTag[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  variants            HandbookVariant[]

  @@index([category, orderIndex])
}

model HandbookVariant {
  id           String             @id @default(cuid())
  pageId       String
  bodyMarkdown String             @db.Text
  orderIndex   Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  page         HandbookPage       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  audiences    HandbookAudience[]

  @@index([pageId])
}

model HandbookAudience {
  variantId String
  team      TeamTag

  variant   HandbookVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([variantId, team])
  @@index([team])
}

// ---------------------------------------------------------------------------
// Clientele
//
// The client roster is HR-governed, which is why it does not reuse Project:
// projects are created by any signed-in user and own their own tasks, whereas a
// client and who works on it are set by HR alone.
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ClientRole {
  MANAGER
  MEMBER
}

enum RosterRequestAction {
  ADD
  REMOVE
}

enum RosterRequestStatus {
  PENDING
  COMPLETED
  DISMISSED
}

model Client {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  status      ClientStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignments    ClientAssignment[]
  rosterRequests ClientRosterRequest[]

  @@index([status])
}

model ClientAssignment {
  id        String     @id @default(cuid())
  clientId  String
  userId    String
  role      ClientRole @default(MEMBER)
  createdAt DateTime   @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation("ClientAssignee", fields: [userId], references: [id], onDelete: Cascade)

  // One row per person per client; the role says whether they lead it.
  @@unique([clientId, userId])
  @@index([clientId])
  @@index([userId])
}

/// A manager asking HR to change who works on their client.
///
/// Stored rather than only emailed, so HR can work from a queue in the admin page
/// and so a request that arrives while someone is away is not lost in an inbox.
model ClientRosterRequest {
  id            String              @id @default(cuid())
  clientId      String
  requestedById String
  note          String?
  status        RosterRequestStatus @default(PENDING)
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  client      Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy User                      @relation("RosterRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  resolvedBy  User?                     @relation("RosterResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  items       ClientRosterRequestItem[]

  @@index([clientId])
  @@index([status])
  @@index([requestedById])
}

model ClientRosterRequestItem {
  id        String              @id @default(cuid())
  requestId String
  userId    String
  action    RosterRequestAction
  /// Which role to give them; only meaningful for ADD.
  role      ClientRole?

  request ClientRosterRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User                @relation("RosterRequestSubject", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId, action])
  @@index([requestId])
  @@index([userId])
}

// ─── KPI module (monthly KPIs + Execution verification) ─────────────────────
// User references are plain id columns (like Evaluation.evaluateeId) to avoid
// adding back-relations to User. Nothing here is hard-deleted.

enum KpiScope {
  TEAM
  DEPARTMENT
}

enum KpiEvidenceType {
  LINK
  DOCUMENT
  NUMBER
  CLIENT_CONFIRMATION
}

enum KpiStatus {
  DRAFT
  LOCKED
  CLAIMED_DONE
  NOT_DONE
  NEEDS_INFO
  REJECTED
  APPEALED
  VERIFIED
  NOT_VERIFIED
  CANCELLED
}

enum KpiGrantRole {
  VERIFIER
  DEPARTMENT_SETTER
}

enum KpiChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

model KpiMonth {
  id            String    @id @default(cuid())
  year          Int
  month         Int
  goalsLockAt   DateTime
  claimsDueAt   DateTime
  verifyDueAt   DateTime
  responseDueAt DateTime
  targetFinalAt DateTime
  finalizedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  goals         KpiGoal[]

  @@unique([year, month])
}

model KpiGoal {
  id            String    @id @default(cuid())
  kpiMonthId    String
  scope         KpiScope
  departmentKey String?
  setterId      String
  title         String
  description   String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  kpiMonth      KpiMonth  @relation(fields: [kpiMonthId], references: [id])
  kpis          Kpi[]

  @@index([kpiMonthId, scope, setterId])
  @@index([kpiMonthId, departmentKey])
}

model Kpi {
  id             String             @id @default(cuid())
  goalId         String
  title          String
  target         String
  evidenceType   KpiEvidenceType
  status         KpiStatus          @default(DRAFT)
  lockedSnapshot Json?
  claimedById    String?
  claimedAt      DateTime?
  claimNote      String?
  claimUrl       String?
  reportedValue  String?
  appealUsedAt   DateTime?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  dueDate        DateTime?
  version        Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  goal           KpiGoal            @relation(fields: [goalId], references: [id])
  assignees      KpiAssignee[]
  files          KpiEvidenceFile[]
  changes        KpiChangeRequest[]
  comments       KpiComment[]

  @@index([goalId])
  @@index([status])
}

/// A comment on one KPI: Execution, HR, the setter and owners discuss it in one thread.
model KpiComment {
  id        String   @id @default(cuid())
  kpiId     String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  kpi       Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([kpiId, createdAt])
}

model KpiAssignee {
  kpiId  String
  userId String
  kpi    Kpi    @relation(fields: [kpiId], references: [id])

  @@id([kpiId, userId])
  @@index([userId])
}

model KpiEvidenceFile {
  id           String   @id @default(cuid())
  kpiId        String
  blobPath     String
  fileName     String
  contentType  String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())
  kpi          Kpi      @relation(fields: [kpiId], references: [id])

  @@index([kpiId])
}

model KpiChangeRequest {
  id            String          @id @default(cuid())
  kpiId         String
  requestedById String
  proposed      Json
  reason        String
  status        KpiChangeStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime        @default(now())
  kpi           Kpi             @relation(fields: [kpiId], references: [id])

  @@index([kpiId, status])
}

model KpiSetterAssignment {
  id          String   @id @default(cuid())
  employeeId  String
  setterId    String
  reason      String
  createdById String
  createdAt   DateTime @default(now())

  @@unique([employeeId, setterId])
}

model KpiRoleGrant {
  id          String       @id @default(cuid())
  userId      String
  role        KpiGrantRole
  createdById String
  createdAt   DateTime     @default(now())

  @@unique([userId, role])
}

model KpiEvent {
  id         String   @id @default(cuid())
  kpiId      String?
  kpiMonthId String?
  actorId    String?
  actorRole  String
  action     String
  fromStatus String?
  toStatus   String?
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([kpiId, createdAt])
  @@index([kpiMonthId, createdAt])
}

model KpiNotification {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  dedupeKey String   @unique
  sentAt    DateTime @default(now())
}


// ─── Weekly evaluations ─────────────────────────────────────────────────────

enum WeeklyPerspective {
  LEAD
  UPWARD
  PEER
}

enum WeeklyCycleStatus {
  SETUP
  RUNNING
  CLOSED
}

enum WeeklyProfileStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum WeeklySlotStatus {
  OPEN
  SATISFIED
  CLOSED_NOT_OBSERVED
  CANCELLED
}

enum WeeklyPromptKind {
  STANDARD
  COMMENT
}

enum WeeklyPromptStatus {
  OPEN
  DRAFT
  SUBMITTED
  NOT_OBSERVED
  EXPIRED
  CANCELLED
}

enum WeeklyReviewAction {
  ACCEPTED
  ADJUSTED
  MARKED_INSUFFICIENT
  EXCLUDED
  AUTO_ACCEPTED
  MANUAL
}

enum WeeklyChallengeStatus {
  OPEN
  UPHELD
  NOT_UPHELD
}

model WeeklyCycle {
  id                 String            @id @default(cuid())
  periodId           String            @unique
  weekOneStartsOn    DateTime
  weeklyCap          Int               @default(5)
  status             WeeklyCycleStatus @default(SETUP)
  simulatedWeek      Int?
  formsOpenAt        DateTime?
  resultsPublishedAt DateTime?
  closedAt           DateTime?
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  slots              WeeklySlot[]
  prompts            WeeklyPrompt[]
}

model WeeklyCompetency {
  id                   String                   @id @default(cuid())
  key                  String                   @unique
  perspective          WeeklyPerspective
  name                 String
  definition           String
  sourceQuestionId     String?
  sourceLeadQuestionId String?                  @unique
  leadId               String?
  cycleId              String?
  isActive             Boolean                  @default(true)
  /// Removed by HR from the weekly bank; sync leaves it off until HR restores it.
  removedAt            DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  prompts              WeeklyCompetencyPrompt[]
  profiles             WeeklyProfile[]
  slots                WeeklySlot[]

  @@index([perspective, isActive])
  @@index([sourceQuestionId])
  @@index([cycleId, leadId])
}

model WeeklyCompetencyPrompt {
  id           String           @id @default(cuid())
  competencyId String
  variant      String
  text         String
  isActive     Boolean          @default(true)
  /// Removed by HR after it was asked: kept so earlier answers keep their question, hidden from the bank.
  archivedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  competency   WeeklyCompetency @relation(fields: [competencyId], references: [id])

  @@unique([competencyId, variant])
}

model WeeklyProfile {
  id                     String              @id @default(cuid())
  competencyId           String
  version                Int
  levels                 Json
  insufficientDefinition String
  status                 WeeklyProfileStatus @default(DRAFT)
  incomplete             Boolean             @default(false)
  createdById            String?
  approvedById           String?
  approvedAt             DateTime?
  createdAt              DateTime            @default(now())
  competency             WeeklyCompetency    @relation(fields: [competencyId], references: [id])

  @@unique([competencyId, version])
  @@index([competencyId, status])
}

model WeeklySlot {
  id               String           @id @default(cuid())
  cycleId          String
  evaluatorId      String
  evaluateeId      String
  relationshipType RelationshipType
  competencyId     String
  status           WeeklySlotStatus @default(OPEN)
  notObservedCount Int              @default(0)
  snoozedUntilWeek Int?
  lastAskedWeek    Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  cycle            WeeklyCycle      @relation(fields: [cycleId], references: [id])
  competency       WeeklyCompetency @relation(fields: [competencyId], references: [id])
  prompts          WeeklyPrompt[]

  @@unique([cycleId, evaluatorId, evaluateeId, relationshipType, competencyId])
  @@index([cycleId, evaluatorId, status])
  @@index([cycleId, evaluateeId])
}

model WeeklyPrompt {
  id               String             @id @default(cuid())
  cycleId          String
  slotId           String?
  evaluatorId      String
  evaluateeId      String
  relationshipType RelationshipType
  weekIndex        Int
  kind             WeeklyPromptKind   @default(STANDARD)
  promptVariantId  String?
  questionId       String?
  textSnapshot     String
  status           WeeklyPromptStatus @default(OPEN)
  releasedAt       DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  cycle            WeeklyCycle        @relation(fields: [cycleId], references: [id])
  slot             WeeklySlot?        @relation(fields: [slotId], references: [id])
  response         WeeklyResponse?

  @@unique([cycleId, evaluatorId, evaluateeId, relationshipType, questionId])
  @@index([cycleId, evaluatorId, status])
  @@index([slotId, weekIndex])
}

model WeeklyRelease {
  id          String   @id @default(cuid())
  cycleId     String
  weekIndex   Int
  evaluatorId String
  promptCount Int
  createdAt   DateTime @default(now())

  @@unique([cycleId, weekIndex, evaluatorId])
}

model WeeklyResponse {
  id          String       @id @default(cuid())
  promptId    String       @unique
  situation   String       @default("")
  action      String       @default("")
  result      String       @default("")
  shortfall   String?
  commentText String?
  revision    Int          @default(0)
  submittedAt DateTime?
  lockedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  prompt      WeeklyPrompt @relation(fields: [promptId], references: [id])
}

model WeeklyScoringJob {
  id         String    @id @default(cuid())
  responseId String
  revision   Int
  status     String    @default("PENDING")
  attempts   Int       @default(0)
  runAfter   DateTime  @default(now())
  leaseUntil DateTime?
  leaseToken String?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([responseId, revision])
  @@index([status, runAfter])
}

model WeeklyAiScore {
  id                      String   @id @default(cuid())
  responseId              String
  revision                Int
  profileId               String
  model                   String
  promptVersion           String
  sufficiency             String
  score                   Int?
  confidence              String
  criteriaMet             Json
  criteriaNotDemonstrated Json
  evidenceQuotes          Json
  rationale               String
  flags                   Json
  inputTokens             Int      @default(0)
  outputTokens            Int      @default(0)
  createdAt               DateTime @default(now())

  @@unique([responseId, revision, profileId, model, promptVersion])
  @@index([responseId])
}

model WeeklyScoreReview {
  id         String             @id @default(cuid())
  responseId String
  aiScoreId  String?
  action     WeeklyReviewAction
  finalScore Float?
  reason     String?
  reviewerId String?
  createdAt  DateTime           @default(now())

  @@index([responseId, createdAt])
}

model WeeklyAggregationRun {
  id        String   @id @default(cuid())
  cycleId   String
  runById   String
  counts    Json
  drops     Json
  createdAt DateTime @default(now())

  @@index([cycleId, createdAt])
}

model WeeklyChallenge {
  id           String                @id @default(cuid())
  cycleId      String
  evaluateeId  String
  reason       String
  status       WeeklyChallengeStatus @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime              @default(now())

  @@unique([cycleId, evaluateeId])
}

model WeeklyParticipantOverride {
  id          String   @id @default(cuid())
  cycleId     String
  userId      String
  optIn       Boolean  @default(true)
  reason      String
  createdById String
  createdAt   DateTime @default(now())

  @@unique([cycleId, userId])
}

model WeeklyNotification {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  dedupeKey String   @unique
  delivered Boolean  @default(true)
  sentAt    DateTime @default(now())
}

model WeeklyAuditEvent {
  id         String   @id @default(cuid())
  cycleId    String?
  actorId    String?
  actorRole  String
  action     String
  objectType String
  objectId   String?
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([cycleId, createdAt])
}

// ─── Weekly evaluations: AI settings and calibration (Part D) ───────────────

model WeeklyAiSettings {
  id          String   @id @default("default")
  activeModel String?
  /// model id → { inputPerMillion, outputPerMillion } in US dollars
  prices      Json     @default("{}")
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model WeeklyCalibrationItem {
  id               String    @id @default(cuid())
  competencyId     String
  question         String
  situation        String
  action           String
  result           String
  shortfall        String?
  hrSufficiency    String // SUFFICIENT | INSUFFICIENT
  hrScore          Int?
  note             String?
  sourceResponseId String?   @unique
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?

  @@index([archivedAt])
}

model WeeklyCalibrationRun {
  id            String                    @id @default(cuid())
  kind          String // SET | CYCLE
  cycleId       String?
  model         String
  promptVersion String
  status        String                    @default("RUNNING") // RUNNING | DONE | FAILED
  itemCount     Int
  leaseUntil    DateTime?
  startedById   String
  createdAt     DateTime                  @default(now())
  finishedAt    DateTime?
  summary       Json?
  results       WeeklyCalibrationResult[]

  @@index([kind, status, promptVersion, model])
}

model WeeklyCalibrationResult {
  id                String               @id @default(cuid())
  runId             String
  itemId            String?
  responseId        String?
  competencyId      String
  targetSufficiency String
  targetScore       Float?
  question          String?
  situation         String?
  action            String?
  result            String?
  shortfall         String?
  sufficiency       String?
  score             Int?
  confidence        String?
  rationale         String?
  flags             Json?
  evidenceQuotes    Json?
  profileId         String?
  inputTokens       Int                  @default(0)
  outputTokens      Int                  @default(0)
  latencyMs         Int                  @default(0)
  error             String?
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  run               WeeklyCalibrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, itemId])
  @@unique([runId, responseId])
  @@index([runId, completedAt])
}
