// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  HR
  SECURITY
  OA
  EXECUTION
}

/// Person-level team. Exactly one per user; drives Handbook visibility.
/// "Everyone" and "Plutus21 Internal Team" are derived groups, never stored.
enum TeamTag {
  PAKISTAN
  MOROCCO
  COLOMBIA
  INDONESIA
  NOBLE
  THREE_E_PAKISTAN
  THREE_E_MOROCCO
}

enum HandbookCategory {
  START_HERE
  THE_COMPANY
  POLICIES
  BENEFITS_AND_REWARDS
  PERFORMANCE
  HOW_TO
}

/// How a page's body is presented. POLICY is the calm default; LETTER is the
/// correspondence treatment (serif, generous measure, sign-off under a rule).
enum HandbookLayout {
  POLICY
  LETTER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
}

enum RelationshipType {
  DIRECT_REPORT
  TEAM_LEAD
  PEER
  C_LEVEL
  HR
  DEPT
  CROSS_DEPARTMENT
  SELF
}

enum QuestionType {
  RATING
  TEXT
}

enum PreEvaluationTriggerSource {
  AUTO
  MANUAL
}

enum PreEvaluationLeadStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  OVERRIDDEN
}

enum PreEvaluationReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PreEvaluationEvaluateeType {
  PRIMARY
  PEER
  CROSS_DEPARTMENT
}

enum EvaluationPeriodOverrideAction {
  ADD
  REMOVE
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
}

enum LeaveStatus {
  PENDING           // Waiting for approvals
  LEAD_APPROVED     // Lead approved, waiting for HR
  HR_APPROVED       // HR approved, waiting for Lead  
  APPROVED          // Both approved
  REJECTED          // Either rejected
  CANCELLED         // Employee cancelled
}

enum HalfDaySession {
  FIRST_HALF
  SECOND_HALF
}

enum LeaveAuditChannel {
  EMAIL
  CALENDAR
  // A state change the portal made on its own, with no message sent -- currently
  // only the automatic cancellation of a leave with no transition plan.
  SYSTEM
}

enum LeaveAuditEventType {
  REQUEST_NOTIFICATION
  APPROVAL_NOTIFICATION
  TRANSITION_PLAN_REMINDER
  TRANSITION_PLAN_SUBMITTED
  TRANSITION_PLAN_DISAPPROVED
  TRANSITION_PLAN_ESCALATION
  // The deadline ladder for leaves longer than two working days. NOTICE is not
  // just a log line: its createdAt is what the cancellation deadline is computed
  // from, so no successful notice means no deadline and no cancellation.
  TRANSITION_PLAN_NOTICE
  TRANSITION_PLAN_FINAL_WARNING
  TRANSITION_PLAN_AUTO_CANCELLED
  CALENDAR_SYNC
  CALENDAR_REMOVE
}

enum LeaveTransitionPlanLeadStatus {
  PENDING
  APPROVED
  DISAPPROVED
}

enum LeaveAuditStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum TicketStatus {
  OPEN             // Employee just submitted
  UNDER_REVIEW     // HR is looking at it
  SOLUTION         // HR has a solution, sharing with employee
  RESOLVED         // Issue is closed
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  IN_REPAIR
  RETIRED
  LOST
  DISPOSED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

enum TransportMode {
  CAR
  BIKE
  PUBLIC_TRANSPORT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  PUBLIC_HOLIDAY
}

enum AttendanceSource {
  MANUAL
  IMPORT
  SYSTEM
}

enum SalaryHeadType {
  EARNING
  DEDUCTION
}

enum PayrollPeriodStatus {
  DRAFT
  CALCULATED
  APPROVED
  SENDING
  SENT
  PARTIAL
  FAILED
  LOCKED
}

enum PayrollSourceType {
  WORKBOOK
  MANUAL
  CARRY_FORWARD
}

enum PayrollIdentityStatus {
  AUTO_MATCHED
  MANUAL_MATCHED
  UNRESOLVED
  AMBIGUOUS
}

enum PayrollReceiptStatus {
  DRAFT
  READY
  ENVELOPE_CREATED
  SENT
  COMPLETED
  FAILED
}

enum PayrollImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PositionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum PositionPriority {
  LOW
  MEDIUM
  HIGH
}

enum NewHireStatus {
  PENDING
  ONBOARDING
  COMPLETED
}

enum OnboardingModuleStatus {
  LOCKED
  IN_PROGRESS
  COMPLETED
}

// Standalone counter table used by lib/rate-limit.ts. Not related to any other model.
model RateLimit {
  key      String   @id
  count    Int
  resetAt  DateTime

  @@index([resetAt])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  discordId    String?
  passwordHash    String?  // Hashed password for authentication
  passwordVersion Int      @default(0)
  department      String?
  position     String?
  role         UserRole @default(EMPLOYEE)
  onboardingCompleted Boolean @default(true)
  benefitCategoryId String?
  teamTag           TeamTag?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Org chart position (optional - used to save custom positions)
  chartX      Float?
  chartY      Float?

  // Avatar customization (virtual office, v2)
  avatarSkinTone   String?
  avatarSchemaVersion Int @default(2)
  avatarBodyFrame String?
  avatarOutfitType String?
  avatarOutfitColor String?
  avatarOutfitAccentColor String?
  avatarHairCategory String?
  avatarHairColor String?
  avatarHeadCoveringType String?
  avatarHeadCoveringColor String?
  avatarAccessories Json?

  // Relations
  evaluatorMappings   EvaluatorMapping[] @relation("Evaluator")
  evaluateeMappings   EvaluatorMapping[] @relation("Evaluatee")
  evaluations         Evaluation[]
  weightages          Weightage[]
  reports              Report[]
  emailQueue           EmailQueue[]
  
  // Leave management relations
  leaveRequests       LeaveRequest[]     @relation("LeaveEmployee")
  leaveCovering       LeaveRequest[]     @relation("LeaveCover")
  leaveAuditEvents    LeaveAuditEvent[]  @relation("LeaveAuditActor")
  wfhRequests         WfhRequest[]       @relation("WfhEmployee")
  
  // Device management relations
  deviceTickets       DeviceTicket[]     @relation("DeviceTicketEmployee")
  leaveBalances       LeaveBalance[]
  assignedEquipment   EquipmentAsset[]       @relation("AssetCurrentAssignee")
  equipmentAssignments EquipmentAssignment[] @relation("EquipmentAssignmentEmployee")
  equipmentAssignedBy EquipmentAssignment[]  @relation("EquipmentAssignedBy")
  equipmentUnassignedBy EquipmentAssignment[] @relation("EquipmentUnassignedBy")
  equipmentEventsActed EquipmentEvent[]      @relation("EquipmentEventActor")

  // Payroll management relations
  payrollCreatedPeriods   PayrollPeriod[]         @relation("PayrollCreatedBy")
  payrollApprovedPeriods  PayrollPeriod[]         @relation("PayrollApprovedBy")
  payrollIdentityMappings PayrollIdentityMapping[]
  payrollImportBatches    PayrollImportBatch[]    @relation("PayrollImportedBy")
  payrollExpenseEntries   PayrollExpenseEntry[]   @relation("PayrollExpenseEnteredBy")
  payrollApprovalEvents   PayrollApprovalEvent[]  @relation("PayrollApprovalActor")
  payrollReceipts         PayrollReceipt[]        @relation("PayrollReceiptUser")
  payrollProfile          PayrollEmployeeProfile?
  payrollSalaryRevisionsCreated PayrollSalaryRevision[] @relation("PayrollSalaryRevisionCreatedBy")
  payrollAttendanceEntries PayrollAttendanceEntry[]
  payrollAttendanceUpdated PayrollAttendanceEntry[] @relation("PayrollAttendanceUpdatedBy")
  payrollInputAuditEventsActed PayrollInputAuditEvent[] @relation("PayrollInputAuditActor")

  // Project management relations
  ownedProjects           Project[]               @relation("ProjectOwner")
  projectMemberships      ProjectMember[]
  projectReferencesCreated ProjectReference[]     @relation("ProjectReferenceCreatedBy")
  assignedTasks           Task[]                  @relation("TaskAssignee")
  taskAssistances         TaskAssistant[]         @relation("TaskAssistantUser")
  taskAssistancesAssigned TaskAssistant[]         @relation("TaskAssistantAssignedBy")
  taskComments            TaskComment[]           @relation("TaskCommentAuthor")
  taskActivities          TaskActivity[]          @relation("TaskActivityActor")
  projectNotificationPreference ProjectNotificationPreference?
  projectTaskViewPreference ProjectTaskViewPreference?
  projectNotificationDigestItems ProjectNotificationDigestItem[] @relation("ProjectNotificationDigestRecipient")
  teamLeadPositions       Position[]              @relation("PositionTeamLead")
  newHiresAsTeamLead      NewHire[]               @relation("NewHireTeamLead")
  newHiresAsBuddy         NewHire[]               @relation("NewHireBuddy")
  newHireRecord           NewHire?                @relation("NewHireUser")
  onboardingProgress      OnboardingProgress[]
  quizAttempts            QuizAttempt[]
  officePreference        OfficeUserPreference?
  officeCubicleAssignment OfficeCubicleAssignment?
  officeLeadershipOfficeAssignment OfficeLeadershipOfficeAssignment?
  ownedOfficeRooms        OfficeRoomMetadata[]    @relation("OfficeRoomOwner")
  benefitCategory         BenefitCategory?        @relation(fields: [benefitCategoryId], references: [id], onDelete: SetNull)
  preEvaluationLeadPreps  PreEvaluationLeadPrep[] @relation("PreEvaluationLead")
  preEvaluationOverrides  PreEvaluationLeadPrep[] @relation("PreEvaluationOverrideBy")
  preEvaluationResets     PreEvaluationLeadPrep[] @relation("PreEvaluationResetBy")
  preEvaluationTriggeredPeriods EvaluationPeriod[] @relation("PreEvaluationTriggeredBy")
  preEvaluationSelectionsAsEvaluatee PreEvaluationEvaluateeSelection[] @relation("PreEvaluationSelectionEvaluatee")
  preEvaluationSelectionsAsSuggestedEvaluator PreEvaluationEvaluateeSelection[] @relation("PreEvaluationSelectionSuggestedEvaluator")
  preEvaluationSelectionsReviewed PreEvaluationEvaluateeSelection[] @relation("PreEvaluationSelectionReviewedBy")
  evaluationPeriodOverridesAsEvaluator EvaluationPeriodAssignmentOverride[] @relation("EvaluationPeriodOverrideEvaluator")
  evaluationPeriodOverridesAsEvaluatee EvaluationPeriodAssignmentOverride[] @relation("EvaluationPeriodOverrideEvaluatee")
  evaluationPeriodOverridesCreated EvaluationPeriodAssignmentOverride[] @relation("EvaluationPeriodOverrideCreatedBy")
  evaluationAssignmentSnapshotsAsEvaluator EvaluationPeriodAssignmentSnapshot[] @relation("EvaluationSnapshotEvaluator")
  evaluationAssignmentSnapshotsAsEvaluatee EvaluationPeriodAssignmentSnapshot[] @relation("EvaluationSnapshotEvaluatee")
  subscriptionOwnerships SubscriptionOwner[]
  evaluationEdits        EvaluationEdit[]   @relation("EvaluationEditor")
  clientAssignments      ClientAssignment[] @relation("ClientAssignee")
  rosterRequestsMade     ClientRosterRequest[] @relation("RosterRequester")
  rosterRequestsResolved ClientRosterRequest[] @relation("RosterResolver")
  rosterRequestSubjects  ClientRosterRequestItem[] @relation("RosterRequestSubject")

  @@index([name])
  @@index([email])
  @@index([benefitCategoryId])
}

model OfficeUserPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  preferredStatusText String?
  audioSettings       Json?
  panelLayout         Json?
  dismissedHints      Json?
  selectedDecor       Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OfficeCubicleAssignment {
  id            String   @id @default(cuid())
  userId        String   @unique
  cubicleId     String
  decorJson     Json?
  assignedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cubicleId])
}

model OfficeLeadershipOfficeAssignment {
  id             String   @id @default(cuid())
  userId         String   @unique
  officeId       String
  isLockedByDefault Boolean @default(false)
  decorJson      Json?
  eligibilityOverride Boolean?
  assignedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([officeId])
}

model OfficeRoomMetadata {
  id             String   @id @default(cuid())
  roomId         String   @unique
  label          String
  roomType       String
  capacity       Int?
  ownerId        String?
  privacyDefault String   @default("OPEN")
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner          User?    @relation("OfficeRoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([roomType])
  @@index([ownerId])
}

model OfficeCatalogItem {
  id          String   @id @default(cuid())
  kind        String
  key         String
  label       String
  metadata    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kind, key])
  @@index([kind, isActive])
}

model Subscription {
  id                   String             @id @default(cuid())
  name                 String
  team                 String?
  usersText            String?
  paymentMethodText    String?
  purpose              String?
  costText             String?
  subscriptionTypeText String?
  billedToText         String?
  renewalText          String?
  noticePeriodText     String?
  personInChargeText   String?
  lastPaymentText      String?
  notes                String?
  sourceSheet          String?
  status               SubscriptionStatus @default(ACTIVE)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  ownerLinks SubscriptionOwner[]

  @@index([status])
  @@index([team])
}

model SubscriptionOwner {
  subscriptionId String
  userId         String
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, userId])
  @@index([userId])
}

model EvaluatorMapping {
  id               String           @id @default(cuid())
  evaluatorId      String
  evaluateeId      String
  relationshipType RelationshipType
  createdAt        DateTime         @default(now())

  evaluator User @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  evaluatee User @relation("Evaluatee", fields: [evaluateeId], references: [id], onDelete: Cascade)

  @@unique([evaluatorId, evaluateeId, relationshipType])
  @@index([evaluatorId])
  @@index([evaluateeId])
}

model EvaluationQuestion {
  id               String           @id @default(cuid())
  relationshipType RelationshipType
  questionText     String
  questionType     QuestionType     @default(RATING)
  maxRating        Int              @default(4)
  rating1Description String?
  rating2Description String?
  rating3Description String?
  rating4Description String?
  orderIndex       Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  evaluations Evaluation[]

  @@unique([relationshipType, orderIndex])
  @@index([relationshipType, orderIndex])
}

model EvaluationPeriod {
  id                      String                     @id @default(cuid())
  name                    String                     // e.g., "Q3 2025"
  startDate               DateTime
  endDate                 DateTime
  reviewStartDate         DateTime
  isActive                Boolean                    @default(true)
  isLocked                Boolean                    @default(false) // Prevents new submissions when locked
  preEvaluationTriggeredAt DateTime?
  preEvaluationTriggerSource PreEvaluationTriggerSource?
  preEvaluationTriggeredById String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  reports                 Report[]
  evaluations             Evaluation[]
  preEvaluationPreps      PreEvaluationLeadPrep[]
  assignmentOverrides     EvaluationPeriodAssignmentOverride[]
  assignmentSnapshots      EvaluationPeriodAssignmentSnapshot[]
  preEvaluationTriggeredBy User?                    @relation("PreEvaluationTriggeredBy", fields: [preEvaluationTriggeredById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([startDate])
  @@index([reviewStartDate])
  @@index([preEvaluationTriggeredAt])
}

model Evaluation {
  id             String                     @id @default(cuid())
  evaluatorId    String
  evaluateeId    String
  questionId     String?
  leadQuestionId String?
  periodId       String
  ratingValue    Float?
  textResponse   String?
  submittedAt    DateTime?
  source           String                     @default("MANUAL") // MANUAL | AI_WEEKLY
  aggregationRunId String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  evaluator      User                       @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  question       EvaluationQuestion?        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  leadQuestion   PreEvaluationLeadQuestion? @relation(fields: [leadQuestionId], references: [id], onDelete: Cascade)
  period         EvaluationPeriod           @relation(fields: [periodId], references: [id], onDelete: Cascade)

  edits          EvaluationEdit[]

  @@unique([evaluatorId, evaluateeId, questionId, periodId])
  @@unique([evaluatorId, evaluateeId, leadQuestionId, periodId])
  @@index([evaluatorId])
  @@index([evaluateeId])
  @@index([periodId])
  @@index([leadQuestionId])
  @@index([periodId, source])
}

/// A correction made by HR to a submitted evaluation.
///
/// Submitted evaluations are otherwise locked, so HR is the only way to fix a
/// mis-click. These scores feed the reports employees receive, so every change
/// keeps the previous value: a changed rating with no history would be impossible
/// to explain or dispute afterwards.
model EvaluationEdit {
  id             String   @id @default(cuid())
  evaluationId   String
  editedById     String
  previousRating Float?
  newRating      Float?
  previousText   String?
  newText        String?
  reason         String?
  createdAt      DateTime @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  editedBy   User       @relation("EvaluationEditor", fields: [editedById], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([editedById])
}

model EvaluationPeriodAssignmentOverride {
  id               String                         @id @default(cuid())
  periodId         String
  evaluatorId      String
  evaluateeId      String
  relationshipType RelationshipType
  action           EvaluationPeriodOverrideAction
  note             String?
  createdById      String?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  period           EvaluationPeriod               @relation(fields: [periodId], references: [id], onDelete: Cascade)
  evaluator        User                           @relation("EvaluationPeriodOverrideEvaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  evaluatee        User                           @relation("EvaluationPeriodOverrideEvaluatee", fields: [evaluateeId], references: [id], onDelete: Cascade)
  createdBy        User?                          @relation("EvaluationPeriodOverrideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([periodId, evaluatorId, evaluateeId, relationshipType])
  @@index([periodId])
  @@index([evaluatorId])
  @@index([evaluateeId])
  @@index([action])
}

model EvaluationPeriodAssignmentSnapshot {
  id               String           @id @default(cuid())
  periodId         String
  evaluatorId      String
  evaluateeId      String
  relationshipType RelationshipType
  source           String
  sourceRefId      String?
  createdAt        DateTime         @default(now())

  period           EvaluationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  evaluator        User             @relation("EvaluationSnapshotEvaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  evaluatee        User             @relation("EvaluationSnapshotEvaluatee", fields: [evaluateeId], references: [id], onDelete: Cascade)

  @@unique([periodId, evaluatorId, evaluateeId, relationshipType])
  @@index([periodId])
  @@index([evaluatorId])
  @@index([evaluateeId])
}

model PreEvaluationLeadPrep {
  id                     String                    @id @default(cuid())
  periodId               String
  leadId                 String
  status                 PreEvaluationLeadStatus  @default(PENDING)
  questionsSubmittedAt   DateTime?
  questionsCarriedForwardAt DateTime?
  questionsCarriedFromPeriodId String?
  evaluateesSubmittedAt  DateTime?
  completedAt            DateTime?
  overdueAt              DateTime?
  overriddenAt           DateTime?
  overriddenById         String?
  overrideNote           String?
  lastResetAt            DateTime?
  resetById              String?
  resetNote              String?
  initialReminderSentAt  DateTime?
  sevenDayReminderSentAt DateTime?
  oneDayReminderSentAt   DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  period                 EvaluationPeriod         @relation(fields: [periodId], references: [id], onDelete: Cascade)
  lead                   User                     @relation("PreEvaluationLead", fields: [leadId], references: [id], onDelete: Cascade)
  overriddenBy           User?                    @relation("PreEvaluationOverrideBy", fields: [overriddenById], references: [id], onDelete: SetNull)
  resetBy                User?                    @relation("PreEvaluationResetBy", fields: [resetById], references: [id], onDelete: SetNull)
  questions              PreEvaluationLeadQuestion[]
  evaluateeSelections    PreEvaluationEvaluateeSelection[]

  @@unique([periodId, leadId])
  @@index([leadId])
  @@index([periodId])
  @@index([status])
}

model PreEvaluationLeadQuestion {
  id           String                @id @default(cuid())
  prepId        String
  orderIndex    Int
  questionText  String
  rating1Description String?
  rating2Description String?
  rating3Description String?
  rating4Description String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  prep          PreEvaluationLeadPrep @relation(fields: [prepId], references: [id], onDelete: Cascade)
  evaluations   Evaluation[]          @relation

  @@unique([prepId, orderIndex])
  @@index([prepId])
}

model PreEvaluationEvaluateeSelection {
  id                   String                   @id @default(cuid())
  prepId               String
  type                 PreEvaluationEvaluateeType
  evaluateeId          String
  suggestedEvaluatorId String?
  selectionKey         String
  reviewStatus         PreEvaluationReviewStatus @default(PENDING)
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNote           String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  prep                 PreEvaluationLeadPrep    @relation(fields: [prepId], references: [id], onDelete: Cascade)
  evaluatee            User                     @relation("PreEvaluationSelectionEvaluatee", fields: [evaluateeId], references: [id], onDelete: Cascade)
  suggestedEvaluator   User?                    @relation("PreEvaluationSelectionSuggestedEvaluator", fields: [suggestedEvaluatorId], references: [id], onDelete: SetNull)
  reviewedBy           User?                    @relation("PreEvaluationSelectionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([prepId, selectionKey])
  @@index([prepId])
  @@index([evaluateeId])
  @@index([suggestedEvaluatorId])
  @@index([reviewStatus])
}

model Weightage {
  id                 String           @id @default(cuid())
  employeeId         String
  relationshipType   RelationshipType
  weightagePercentage Float
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, relationshipType])
  @@index([employeeId])
}

model Report {
  id           String   @id @default(cuid())
  employeeId   String
  periodId     String
  overallScore Float
  breakdownJson Json    // Store detailed breakdown as JSON
  isAnonymized Boolean  @default(false) // Whether evaluator names are hidden
  generatedAt  DateTime @default(now())

  employee User            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period   EvaluationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  emailQueue EmailQueue[]

  @@unique([employeeId, periodId])
  @@index([employeeId])
  @@index([periodId])
}

model EmailQueue {
  id         String      @id @default(cuid())
  employeeId String
  reportId   String?
  emailStatus EmailStatus @default(PENDING)
  scheduledAt DateTime?
  sentAt     DateTime?
  errorMessage String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  employee User    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([emailStatus])
  @@index([employeeId])
}

// Leave Management
model LeaveRequest {
  id              String      @id @default(cuid())
  employeeId      String
  leaveType       LeaveType
  isHalfDay       Boolean     @default(false)
  halfDaySession  HalfDaySession?
  requestTimezone String      @default("Asia/Karachi")
  unavailableStartTime String?  // HH:mm
  unavailableEndTime   String?  // HH:mm
  startDate       DateTime
  endDate         DateTime
  reason          String
  transitionPlan  String      // Legacy free-text handover notes (optional general notes)
  transitionPlanTasks             Json?     // Structured task rows (see lib/leave-transition-plan.ts)
  transitionPlanSubmittedAt       DateTime? // The "submitted/done" signal
  transitionPlanLeadStatus        LeaveTransitionPlanLeadStatus @default(PENDING)
  transitionPlanLeadReviewedAt    DateTime?
  transitionPlanLeadReviewedById  String?
  transitionPlanDisapprovalReason String?
  hrRepresentative                String?   // Header field (optional)
  coverPersonId   String?     // Who covers their tasks
  coverPersonIds  Json?       // Array of cover person user IDs (first item mirrors coverPersonId)
  additionalNotifyIds Json?   // Array of user IDs to CC on email (notification only, not approval)
  status          LeaveStatus @default(PENDING)
  
  leadApprovedBy  String?     // Lead who approved
  leadApprovedAt  DateTime?
  leadComment     String?
  
  hrApprovedBy    String?     // HR who approved
  hrApprovedAt    DateTime?
  hrComment       String?
  
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  employee        User        @relation("LeaveEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  coverPerson     User?       @relation("LeaveCover", fields: [coverPersonId], references: [id], onDelete: SetNull)
